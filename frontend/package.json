{
  "name": "automation-tool-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "audit:production-package": "node scripts/audit-production-package.mjs",
    "build:control-plane-e2e-assets": "tsc -b && vite build --mode control-plane-e2e",
    "build:browser-settings-e2e-assets": "tsc -b && vite build --mode browser-settings-e2e",
    "build:desktop-e2e-assets": "tsc -b && vite build --mode desktop-e2e",
    "build:tauri:control-plane-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.control-plane-e2e.conf.json",
    "build:tauri:browser-settings-test": "tauri build --debug --no-bundle --features desktop-e2e --config src-tauri/tauri.browser-settings-e2e.conf.json",
    "build:tauri:executor-lifecycle-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.executor-lifecycle-e2e.conf.json",
    "build:tauri:installation-revocation-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.installation-revocation-e2e.conf.json",
    "build:tauri:task-creation-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.task-creation-e2e.conf.json",
    "build:tauri:task-create-form-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.task-create-form-e2e.conf.json",
    "build:tauri:task-lifecycle-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.task-lifecycle-e2e.conf.json",
    "build:tauri:task-restart-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.task-restart-e2e.conf.json",
    "build:tauri:app-crash-recovery-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.app-crash-recovery-e2e.conf.json",
    "build:tauri:executor-crash-recovery-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.executor-crash-recovery-e2e.conf.json",
    "build:tauri:control-plane-recovery-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.control-plane-recovery-e2e.conf.json",
    "build:tauri:network-recovery-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.network-recovery-e2e.conf.json",
    "build:tauri:task-run-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.task-run-e2e.conf.json",
    "build:tauri:task-query-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.task-query-e2e.conf.json",
    "build:tauri:task-event-stream-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.task-event-stream-e2e.conf.json",
    "build:tauri:task-control-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.task-control-e2e.conf.json",
    "build:tauri:task-discovery-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.task-discovery-e2e.conf.json",
    "build:tauri:task-target-preview-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.task-target-preview-e2e.conf.json",
    "build:tauri:task-target-preview-ui-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.task-target-preview-ui-e2e.conf.json",
    "build:tauri:task-termination-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.task-termination-e2e.conf.json",
    "build:tauri:task-projection-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.task-projection-e2e.conf.json",
    "build:tauri:workbench-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.workbench-e2e.conf.json",
    "build:tauri:platform-session-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.platform-session-e2e.conf.json",
    "build:tauri:platform-session-reuse-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.platform-session-reuse-e2e.conf.json",
    "build:tauri:default-profile-isolation-test": "tauri build --debug --no-bundle --features control-plane-e2e --config src-tauri/tauri.default-profile-isolation-e2e.conf.json",
    "build:tauri:test": "tauri build --debug --no-bundle --features desktop-e2e --config src-tauri/tauri.test.conf.json",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:api": "node scripts/openapi.mjs --check",
    "check:production-boundaries": "pnpm build && node scripts/check-production-boundaries.mjs",
    "generate:api": "node scripts/openapi.mjs",
    "lint": "eslint . --max-warnings 0",
    "tauri": "tauri",
    "test": "pnpm test:contracts && pnpm test:unit",
    "test:contracts": "node --test tests/*.test.mjs",
    "test:control-plane-tauri": "pnpm build:tauri:control-plane-test && wdio run wdio.control-plane.conf.ts",
    "test:browser-settings-tauri": "python3 ../scripts/run_b5_04_acceptance.py",
    "test:executor-lifecycle-tauri": "pnpm build:tauri:executor-lifecycle-test && wdio run wdio.executor-lifecycle.conf.ts",
    "test:installation-revocation-tauri": "pnpm build:tauri:installation-revocation-test && wdio run wdio.installation-revocation.conf.ts",
    "test:task-creation-tauri": "pnpm build:tauri:task-creation-test && wdio run wdio.task-creation.conf.ts",
    "test:task-create-form-tauri": "pnpm build:tauri:task-create-form-test && wdio run wdio.task-create-form.conf.ts",
    "test:task-lifecycle-tauri": "pnpm build:tauri:task-lifecycle-test && wdio run wdio.task-lifecycle.conf.ts",
    "test:task-restart-tauri": "pnpm build:tauri:task-restart-test && wdio run wdio.task-restart.conf.ts",
    "test:h8-04-tauri": "../backend/.venv/bin/python ../scripts/run_h8_04_acceptance.py",
    "test:h8-05-tauri": "../backend/.venv/bin/python ../scripts/run_h8_05_acceptance.py",
    "test:h8-06-tauri": "../backend/.venv/bin/python ../scripts/run_h8_06_acceptance.py",
    "test:h8-07-tauri": "../backend/.venv/bin/python ../scripts/run_h8_07_acceptance.py",
    "test:task-run-tauri": "pnpm build:tauri:task-run-test && wdio run wdio.task-run.conf.ts",
    "test:task-query-tauri": "pnpm build:tauri:task-query-test && wdio run wdio.task-query.conf.ts",
    "test:task-event-stream-tauri": "pnpm build:tauri:task-event-stream-test && wdio run wdio.task-event-stream.conf.ts",
    "test:task-control-tauri": "pnpm build:tauri:task-control-test && wdio run wdio.task-control.conf.ts",
    "test:h8-03-tauri": "../backend/.venv/bin/python ../scripts/run_h8_03_acceptance.py",
    "test:task-discovery-tauri": "pnpm build:tauri:task-discovery-test && wdio run wdio.task-discovery.conf.ts",
    "test:task-target-preview-tauri": "pnpm build:tauri:task-target-preview-test && wdio run wdio.task-target-preview.conf.ts",
    "test:task-target-preview-ui-tauri": "pnpm build:tauri:task-target-preview-ui-test && wdio run wdio.task-target-preview-ui.conf.ts",
    "test:task-termination-tauri": "pnpm build:tauri:task-termination-test && wdio run wdio.task-termination.conf.ts",
    "test:task-projection-tauri": "pnpm build:tauri:task-projection-test && wdio run wdio.task-projection.conf.ts",
    "test:workbench-tauri": "pnpm build:tauri:workbench-test && wdio run wdio.workbench.conf.ts",
    "test:platform-session-tauri": "pnpm build:tauri:platform-session-test && wdio run wdio.platform-session.conf.ts",
    "test:platform-session-reuse-tauri": "../backend/.venv/bin/python ../scripts/run_b5_15_acceptance.py",
    "test:default-profile-isolation-tauri": "../backend/.venv/bin/python ../scripts/run_b5_16_acceptance.py",
    "test:e2e": "playwright test",
    "test:e4-15": "node --test tests/production-package-audit.test.mjs",
    "test:layers": "pnpm test && pnpm test:ui && pnpm test:rust && pnpm test:tauri",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "test:tauri": "pnpm build:tauri:test && wdio run wdio.conf.ts",
    "test:ui": "playwright test",
    "test:unit": "vitest run",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@tauri-apps/api": "2.11.1",
    "antd": "^6.5.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@wdio/cli": "9.29.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/spec-reporter": "9.29.1",
    "@wdio/tauri-plugin": "1.2.0",
    "@wdio/tauri-service": "1.2.0",
    "@wdio/types": "9.29.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
