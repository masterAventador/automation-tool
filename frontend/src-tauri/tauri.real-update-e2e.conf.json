{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutomationToolH822Acceptance",
  "version": "0.1.0",
  "identifier": "com.aventador.automationtool.h822realacceptance",
  "build": {
    "beforeBuildCommand": "pnpm build:desktop-e2e-h822-real-assets",
    "frontendDist": "../dist-h822-real"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "visible": false
      }
    ],
    "security": {
      "capabilities": [
        "main",
        {
          "identifier": "wdio-real-update",
          "description": "H8-22 isolated real signed updater acceptance access",
          "windows": ["main"],
          "permissions": [
            "wdio:allow-execute",
            "wdio:allow-log-frontend",
            "wdio:allow-debug-plugin",
            "wdio:allow-get-active-window-label",
            "wdio:allow-get-window-states",
            "wdio:allow-list-windows",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
