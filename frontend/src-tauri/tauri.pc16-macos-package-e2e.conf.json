{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Automation Tool PC16 Mac Package Acceptance",
  "version": "0.1.0",
  "identifier": "com.aventador.automationtool.pc16macpackage",
  "build": {
    "beforeBuildCommand": "pnpm build:desktop-e2e-pc16-mac-assets",
    "frontendDist": "../dist-pc16-mac"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "自动化运营工具",
        "visible": false
      }
    ],
    "security": {
      "capabilities": [
        "main",
        {
          "identifier": "wdio-pc16-macos-package",
          "description": "PC-16 isolated macOS package acceptance: the one-sentence film against a real bundled Contents/Resources layout",
          "windows": ["main"],
          "permissions": [
            "wdio:allow-execute",
            "wdio:allow-log-frontend",
            "wdio:allow-debug-plugin",
            "wdio:allow-get-active-window-label",
            "wdio:allow-get-window-states",
            "wdio:allow-list-windows",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
