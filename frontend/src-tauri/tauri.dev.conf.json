{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "security": {
      "devCsp": {
        "default-src": "'self' http://127.0.0.1:1420",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost http://127.0.0.1:1420 data: blob:",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:1420",
        "style-src": "'self' 'unsafe-inline' http://127.0.0.1:1420"
      }
    }
  }
}
