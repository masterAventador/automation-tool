{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "pnpm build:desktop-e2e-assets"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "main",
        {
          "identifier": "wdio",
          "description": "Test-only WebdriverIO access for the desktop E2E build",
          "windows": ["main"],
          "permissions": [
            "wdio:allow-execute",
            "wdio:allow-log-frontend",
            "wdio:allow-debug-plugin",
            "wdio:allow-get-active-window-label",
            "wdio:allow-get-window-states",
            "wdio:allow-list-windows",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  }
}
