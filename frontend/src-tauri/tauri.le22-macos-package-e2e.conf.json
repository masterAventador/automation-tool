{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Automation Tool LE22 Mac Package Acceptance",
  "version": "0.1.0",
  "identifier": "com.aventador.automationtool.le22macpackage",
  "build": {
    "beforeBuildCommand": "pnpm build:desktop-e2e-le22-mac-assets",
    "frontendDist": "../dist-le22-mac"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "自动化运营工具",
        "visible": false
      }
    ],
    "security": {
      "capabilities": [
        "main",
        {
          "identifier": "wdio-le22-macos-package",
          "description": "LE-22 isolated macOS package acceptance through the formal smart-edit UI",
          "windows": ["main"],
          "permissions": [
            "wdio:allow-execute",
            "wdio:allow-log-frontend",
            "wdio:allow-debug-plugin",
            "wdio:allow-get-active-window-label",
            "wdio:allow-get-window-states",
            "wdio:allow-list-windows",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
