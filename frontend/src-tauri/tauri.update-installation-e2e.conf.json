{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.aventador.automationtool.h821acceptance",
  "build": {
    "beforeBuildCommand": "pnpm build:desktop-e2e-h821-assets",
    "frontendDist": "../dist-h821"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "visible": false
      }
    ],
    "security": {
      "capabilities": [
        "main",
        {
          "identifier": "wdio-update-installation",
          "description": "H8-21 hidden App update installation coordination acceptance access",
          "windows": ["main"],
          "permissions": [
            "wdio:allow-execute",
            "wdio:allow-log-frontend",
            "wdio:allow-debug-plugin",
            "wdio:allow-get-active-window-label",
            "wdio:allow-get-window-states",
            "wdio:allow-list-windows",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  }
}
