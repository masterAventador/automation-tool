{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Automation Tool PC16 Windows Package Acceptance",
  "version": "0.1.0",
  "identifier": "com.aventador.automationtool.pc16windowspackage",
  "mainBinaryName": "automation-tool-pc16-windows-package",
  "build": {
    "beforeBuildCommand": "pnpm build:desktop-e2e-pc16-windows-assets",
    "frontendDist": "../dist-pc16-windows"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "自动化运营工具",
        "visible": false
      }
    ],
    "security": {
      "capabilities": [
        "main",
        {
          "identifier": "wdio-pc16-windows-package",
          "description": "PC-16 isolated Windows package acceptance: one-sentence film through the installed NSIS resource layout",
          "windows": ["main"],
          "permissions": [
            "wdio:allow-execute",
            "wdio:allow-log-frontend",
            "wdio:allow-debug-plugin",
            "wdio:allow-get-active-window-label",
            "wdio:allow-get-window-states",
            "wdio:allow-list-windows",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
