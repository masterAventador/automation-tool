{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.aventador.automationtool.h820acceptance",
  "build": {
    "beforeBuildCommand": "pnpm build:desktop-e2e-assets"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "visible": false
      }
    ],
    "security": {
      "capabilities": [
        "main",
        {
          "identifier": "wdio-update-download",
          "description": "H8-20 hidden App update download acceptance access",
          "windows": ["main"],
          "permissions": [
            "wdio:allow-execute",
            "wdio:allow-log-frontend",
            "wdio:allow-debug-plugin",
            "wdio:allow-get-active-window-label",
            "wdio:allow-get-window-states",
            "wdio:allow-list-windows",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  }
}
