{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    // Shared with the app project on purpose: the harness port has to be the
    // same number for the Vite server and its clients, and the unit test that
    // pins it lives under `src/`.
    "src/test-harness/harness-port.ts",
    "eslint.config.js"
  ]
}
