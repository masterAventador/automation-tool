# automation-tool customer Demo edge.
#
# This host already serves unrelated business from the same Nginx, so every
# shared http-level symbol declared here is namespaced with the project prefix
# and no listener claims the shared host default. Rendered by
# `deploy_cloud_demo.py`; do not edit the installed copy in place.

map $http_upgrade $automation_tool_demo_connection_upgrade {
    default upgrade;
    ''      close;
}

limit_req_zone $binary_remote_addr zone=automation_tool_demo_requests:1m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=automation_tool_demo_connections:1m;

server {
    listen 80;
    listen [::]:80;
    server_name __DEMO_HOST__;

    location / {
        return 308 https://__DEMO_HOST__$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DEMO_HOST__;

    ssl_certificate /etc/letsencrypt/live/__DEMO_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DEMO_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:automation_tool_demo_tls:1m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 1m;
    client_header_timeout 10s;
    client_body_timeout 10s;
    keepalive_timeout 30s;
    send_timeout 60s;

    limit_req_status 429;
    limit_conn_status 429;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'" always;

    location / {
        limit_req zone=automation_tool_demo_requests burst=20 nodelay;
        limit_conn automation_tool_demo_connections 20;

        proxy_pass http://__CONTROL_PLANE_ENDPOINT__;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering off;
        proxy_request_buffering on;

        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $automation_tool_demo_connection_upgrade;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $request_id;
        proxy_hide_header Server;
    }
}
