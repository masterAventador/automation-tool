{
  "version": "customer-demo-secrets.v1",
  "delivery": {
    "directory": "/run/secrets",
    "productionMode": "files",
    "maximumBytesPerSecret": 8192,
    "requiredOwner": "root-or-runtime-uid",
    "allowedModes": [
      "0400",
      "0440-root-runtime-group"
    ],
    "symlinksAllowed": false,
    "rotationActivation": "controlled_process_restart"
  },
  "secrets": [
    {
      "id": "database_url",
      "fileName": "database-url",
      "consumers": ["control_plane", "migration_job", "account_operations"],
      "generation": "provider_database_credential",
      "rotation": "new_database_credential_then_controlled_restart",
      "forbidden": ["git", "image", "environment", "argv", "logs", "webview"]
    },
    {
      "id": "account_password_pepper",
      "fileName": "account-password-pepper",
      "consumers": ["control_plane", "account_operations"],
      "generation": "32_random_bytes_base64url",
      "rotation": "versioned_rehash_or_password_reset_then_controlled_restart",
      "forbidden": ["git", "image", "environment", "argv", "logs", "webview"]
    },
    {
      "id": "account_fingerprint_key",
      "fileName": "account-fingerprint-key",
      "consumers": ["control_plane"],
      "generation": "32_random_bytes_base64url",
      "rotation": "revoke_all_account_sessions_then_controlled_restart",
      "forbidden": ["git", "image", "environment", "argv", "logs", "webview"]
    },
    {
      "id": "account_operations_capability_digest",
      "fileName": "account-operations-capability-digest",
      "consumers": ["account_operations"],
      "generation": "sha256_of_32_random_byte_opaque_capability_base64url",
      "rotation": "replace_digest_and_destroy_old_capability",
      "forbidden": ["git", "image", "environment", "argv", "logs", "webview"]
    },
    {
      "id": "action_authorization_private_key",
      "fileName": "action-authorization-private-key",
      "consumers": ["control_plane"],
      "generation": "32_random_byte_ed25519_private_key_base64url",
      "rotation": "distribute_matching_executor_trust_then_controlled_restart",
      "forbidden": ["git", "image", "environment", "argv", "logs", "webview"]
    }
  ],
  "nonSecrets": {
    "accountSessionSigningSecret": "not_used_opaque_tokens",
    "deviceCredentialSigningKey": "not_used_device_owns_key",
    "demoBootstrapPublicKey": "public_verification_material",
    "passwordPepperVersion": "public_rotation_version",
    "actionLimits": "public_policy_configuration"
  }
}
