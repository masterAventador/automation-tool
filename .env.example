# Copy this file to .env and generate two different random passwords.
# Empty passwords intentionally make Docker Compose fail closed.

AUTOMATION_TOOL_DEV_DB_USER=automation_tool_dev
AUTOMATION_TOOL_DEV_DB_PASSWORD=
AUTOMATION_TOOL_DEV_DB_NAME=automation_tool_dev
AUTOMATION_TOOL_DEV_DB_PORT=5432

AUTOMATION_TOOL_TEST_DB_USER=automation_tool_test
AUTOMATION_TOOL_TEST_DB_PASSWORD=
AUTOMATION_TOOL_TEST_DB_NAME=automation_tool_test
AUTOMATION_TOOL_TEST_DB_PORT=5433

# Set this to the development database above when starting Control Plane locally.
# Example shape only; replace <same-dev-password> with DEV_DB_PASSWORD.
AUTOMATION_TOOL_DATABASE_URL=postgresql+asyncpg://automation_tool_dev:<same-dev-password>@127.0.0.1:5432/automation_tool_dev
