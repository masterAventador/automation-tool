# Copy this file to .env and generate two different random passwords.
# Empty passwords intentionally make Docker Compose fail closed.

AUTOMATION_TOOL_DEV_DB_USER=automation_tool_dev
AUTOMATION_TOOL_DEV_DB_PASSWORD=
AUTOMATION_TOOL_DEV_DB_NAME=automation_tool_dev
AUTOMATION_TOOL_DEV_DB_PORT=5432

AUTOMATION_TOOL_TEST_DB_USER=automation_tool_test
AUTOMATION_TOOL_TEST_DB_PASSWORD=
AUTOMATION_TOOL_TEST_DB_NAME=automation_tool_test
AUTOMATION_TOOL_TEST_DB_PORT=5433

# Set this to the development database above when starting Control Plane locally.
# Example shape only; replace <same-dev-password> with DEV_DB_PASSWORD.
AUTOMATION_TOOL_DATABASE_URL=postgresql+asyncpg://automation_tool_dev:<same-dev-password>@127.0.0.1:5432/automation_tool_dev

# Optional: enable Installation registration only when both values are set.
# The public key is canonical base64url without padding; keep its offline private key off-server.
# AUTOMATION_TOOL_DEMO_ENVIRONMENT_ID=demo-cn-1
# AUTOMATION_TOOL_DEMO_BOOTSTRAP_PUBLIC_KEY=<32-byte-ed25519-public-key-base64url>

# Optional as a set: enable server-side action execution only when all five values are set.
# Generate a dedicated 32-byte Ed25519 private seed, encode it as canonical base64url without
# padding, keep it only in the Control Plane secret environment, and configure the matching
# public key in the packaged Local Executor during H8-16D/release assembly.
# AUTOMATION_TOOL_ACTION_AUTHORIZATION_PRIVATE_KEY=<32-byte-ed25519-private-seed-base64url>
# AUTOMATION_TOOL_ACTION_MINIMUM_INTERVAL_SECONDS=5
# AUTOMATION_TOOL_ACTION_TASK_LIMIT=20
# AUTOMATION_TOOL_ACTION_DAILY_LIMIT=100
# AUTOMATION_TOOL_ACTION_CONSECUTIVE_FAILURE_THRESHOLD=3
