{
  "version": "customer-demo-revocation.v1",
  "accountDisable": {
    "entrypoint": "authenticated_operations_emergency_revoke",
    "atomic": true,
    "invalidates": [
      "account_access_sessions",
      "account_refresh_sessions",
      "owned_installations",
      "owned_device_credentials",
      "owned_device_sessions"
    ],
    "preserves": [
      "foreign_accounts",
      "foreign_installations",
      "foreign_sessions"
    ]
  },
  "singleDeviceRevoke": {
    "entrypoint": "account_access_session",
    "optimisticRevisionRequired": true,
    "invalidates": [
      "target_installation",
      "target_device_credential",
      "target_device_sessions"
    ],
    "preserves": [
      "same_account_sibling_installations",
      "foreign_installations",
      "foreign_sessions"
    ]
  },
  "anonymousMutationAllowlist": ["loginAccountSession"],
  "anonymousBusinessWrites": 0,
  "requiredSecuritySchemes": [
    "AccountAccessToken",
    "AccountRecoveryToken",
    "AccountRefreshToken",
    "AppSession",
    "DemoBootstrap",
    "DeviceCredential"
  ],
  "auditRequired": true
}
