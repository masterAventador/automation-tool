{
  "schemaVersion": 1,
  "host": "127.0.0.1",
  "port": 0,
  "workerVersion": "1.3.2",
  "allowedOrigins": [
    "http://tauri.localhost",
    "https://tauri.localhost",
    "tauri://localhost"
  ],
  "routes": [
    { "method": "GET", "path": "/health" },
    { "method": "GET", "path": "/api/v1/capabilities" },
    { "method": "POST", "path": "/api/v1/assets/inspect" }
