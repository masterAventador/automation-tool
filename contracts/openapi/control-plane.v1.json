{
  "components": {
    "schemas": {
      "DeviceSessionCapability": {
        "enum": [
          "app.control-plane",
          "executor.connect"
        ],
        "title": "DeviceSessionCapability",
        "type": "string"
      },
      "DeviceSessionExchangeRequest": {
        "additionalProperties": false,
        "properties": {
          "capability": {
            "$ref": "#/components/schemas/DeviceSessionCapability"
          }
        },
        "required": [
          "capability"
        ],
        "title": "DeviceSessionExchangeRequest",
        "type": "object"
      },
      "DeviceSessionExchangeResponse": {
        "additionalProperties": false,
        "properties": {
          "capability": {
            "$ref": "#/components/schemas/DeviceSessionCapability"
          },
          "expiresAt": {
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
          },
          "issuedAt": {
            "format": "date-time",
            "title": "Issuedat",
            "type": "string"
          },
          "sessionToken": {
            "title": "Sessiontoken",
            "type": "string"
          }
        },
        "required": [
          "sessionToken",
          "capability",
          "issuedAt",
          "expiresAt"
        ],
        "title": "DeviceSessionExchangeResponse",
        "type": "object"
      },
      "ExecutorProtocolCompatibility": {
        "additionalProperties": false,
        "properties": {
          "current": {
            "title": "Current",
            "type": "string"
          },
          "maximumCompatible": {
            "title": "Maximumcompatible",
            "type": "string"
          },
          "minimumCompatible": {
            "title": "Minimumcompatible",
            "type": "string"
          }
        },
        "required": [
          "current",
          "minimumCompatible",
          "maximumCompatible"
        ],
        "title": "ExecutorProtocolCompatibility",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "service": {
            "const": "control-plane",
            "default": "control-plane",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "InstallationAccessResponse": {
        "additionalProperties": false,
        "properties": {
          "installationId": {
            "title": "Installationid",
            "type": "string"
          },
          "status": {
            "const": "active",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "installationId",
          "status"
        ],
        "title": "InstallationAccessResponse",
        "type": "object"
      },
      "InstallationRegistrationRequest": {
        "additionalProperties": false,
        "properties": {
          "challengeId": {
            "format": "uuid",
            "title": "Challengeid",
            "type": "string"
          },
          "environmentId": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Environmentid",
            "type": "string"
          },
          "signature": {
            "maxLength": 86,
            "minLength": 86,
            "title": "Signature",
            "type": "string"
          },
          "signingPayload": {
            "maxLength": 2731,
            "minLength": 1,
            "title": "Signingpayload",
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "environmentId",
          "signingPayload",
          "signature"
        ],
        "title": "InstallationRegistrationRequest",
        "type": "object"
      },
      "InstallationRegistrationResponse": {
        "additionalProperties": false,
        "properties": {
          "deviceCredential": {
            "$ref": "#/components/schemas/IssuedDeviceCredentialResponse"
          },
          "installationId": {
            "format": "uuid",
            "title": "Installationid",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "installationId",
          "status",
          "revision",
          "deviceCredential"
        ],
        "title": "InstallationRegistrationResponse",
        "type": "object"
      },
      "IssuedDeviceCredentialResponse": {
        "additionalProperties": false,
        "properties": {
          "credential": {
            "title": "Credential",
            "type": "string"
          },
          "scope": {
            "title": "Scope",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "credential",
          "version",
          "scope"
        ],
        "title": "IssuedDeviceCredentialResponse",
        "type": "object"
      },
      "RegistrationChallengeRequest": {
        "additionalProperties": false,
        "properties": {
          "devicePublicKey": {
            "maxLength": 43,
            "minLength": 43,
            "title": "Devicepublickey",
            "type": "string"
          },
          "environmentId": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Environmentid",
            "type": "string"
          }
        },
        "required": [
          "environmentId",
          "devicePublicKey"
        ],
        "title": "RegistrationChallengeRequest",
        "type": "object"
      },
      "RegistrationChallengeResponse": {
        "additionalProperties": false,
        "properties": {
          "challengeId": {
            "format": "uuid",
            "title": "Challengeid",
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
          },
          "signingPayload": {
            "title": "Signingpayload",
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "signingPayload",
          "expiresAt"
        ],
        "title": "RegistrationChallengeResponse",
        "type": "object"
      },
      "RevokedDeviceCredentialResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "status"
        ],
        "title": "RevokedDeviceCredentialResponse",
        "type": "object"
      },
      "RotatedDeviceCredentialResponse": {
        "additionalProperties": false,
        "properties": {
          "credential": {
            "title": "Credential",
            "type": "string"
          },
          "scope": {
            "title": "Scope",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "credential",
          "version",
          "scope"
        ],
        "title": "RotatedDeviceCredentialResponse",
        "type": "object"
      },
      "TaskCreateRequest": {
        "additionalProperties": false,
        "properties": {},
        "title": "TaskCreateRequest",
        "type": "object"
      },
      "TaskResponse": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "taskId": {
            "title": "Taskid",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "taskId",
          "status",
          "revision",
          "createdAt",
          "updatedAt"
        ],
        "title": "TaskResponse",
        "type": "object"
      },
      "TaskStatus": {
        "description": "Persisted and public lifecycle states for one task.",
        "enum": [
          "draft",
          "validating",
          "awaiting_device",
          "awaiting_platform_login",
          "discovering_targets",
          "awaiting_confirmation",
          "queued",
          "running",
          "paused",
          "awaiting_human",
          "cancelling",
          "succeeded",
          "partially_succeeded",
          "failed",
          "cancelled",
          "outcome_uncertain"
        ],
        "title": "TaskStatus",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionResponse": {
        "additionalProperties": false,
        "properties": {
          "apiVersion": {
            "title": "Apiversion",
            "type": "string"
          },
          "executorProtocol": {
            "$ref": "#/components/schemas/ExecutorProtocolCompatibility"
          },
          "service": {
            "const": "control-plane",
            "default": "control-plane",
            "title": "Service",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version",
          "apiVersion",
          "executorProtocol"
        ],
        "title": "VersionResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "AppSession": {
        "scheme": "bearer",
        "type": "http"
      },
      "DemoBootstrap": {
        "scheme": "bearer",
        "type": "http"
      },
      "DeviceCredential": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "automation-tool Control Plane",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/device-credentials/revocations": {
      "post": {
        "operationId": "revokeDeviceCredential",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevokedDeviceCredentialResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "DeviceCredential": []
          }
        ],
        "summary": "Revoke Device Credential",
        "tags": [
          "device-credentials"
        ]
      }
    },
    "/api/v1/device-credentials/rotations": {
      "post": {
        "operationId": "rotateDeviceCredential",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RotatedDeviceCredentialResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "DeviceCredential": []
          }
        ],
        "summary": "Rotate Device Credential",
        "tags": [
          "device-credentials"
        ]
      }
    },
    "/api/v1/device-sessions": {
      "post": {
        "operationId": "exchangeDeviceSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceSessionExchangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceSessionExchangeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "DeviceCredential": []
          }
        ],
        "summary": "Exchange Device Session",
        "tags": [
          "device-sessions"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "getSystemHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/installations": {
      "post": {
        "operationId": "completeInstallationRegistration",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InstallationRegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallationRegistrationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "DemoBootstrap": []
          }
        ],
        "summary": "Complete Installation Registration",
        "tags": [
          "installations"
        ]
      }
    },
    "/api/v1/installations/current": {
      "get": {
        "operationId": "getCurrentInstallationAccess",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallationAccessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "AppSession": []
          }
        ],
        "summary": "Get Current Installation Access",
        "tags": [
          "installations"
        ]
      }
    },
    "/api/v1/installations/registration-challenges": {
      "post": {
        "operationId": "issueInstallationRegistrationChallenge",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationChallengeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationChallengeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "DemoBootstrap": []
          }
        ],
        "summary": "Issue Registration Challenge",
        "tags": [
          "installations"
        ]
      }
    },
    "/api/v1/tasks": {
      "post": {
        "operationId": "createTask",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "AppSession": []
          }
        ],
        "summary": "Create Task",
        "tags": [
          "tasks"
        ]
      }
    },
    "/api/v1/version": {
      "get": {
        "operationId": "getSystemVersion",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Version",
        "tags": [
          "system"
        ]
      }
    }
  }
}
