    "agent_model_catalog_or_secret_is_unreadable",
    "agent_model_id_required",
    "agent_model_output_must_be_a_json_object",
    "agent_model_output_was_not_json",
    "agent_model_reply_must_be_a_string",
    "agent_model_returned_empty_content",
    "agent_model_stream_exceeded_the_size_budget",
    "agent_model_timeout_out_of_range",
    "agent_not_a_motionauthoringtools_instance",
    "agent_one_message_is_out_of_range",
    "agent_one_sentence_brief_contract_drifted",
