    "brief_brand_asset_path_not_clean_relative",
    "brief_brand_asset_path_reserved_device",
    "brief_brand_asset_path_trailing_dot_or_space",
    "brief_duration_out_of_range",
    "brief_language_unsupported",
    "brief_text_out_of_range",
    "brief_too_many_brand_assets",
    "duration_not_whole_seconds",
    "model_configuration_shape_invalid",
    "model_configuration_unusable",
    "request_schema_unsupported",
    "request_shape_invalid",
    "request_too_large",
    "video_creation_model_transport_failed",
    "video_creation_model_unavailable",
    "workspace_missing",
    "workspace_not_absolute",
    "workspace_unusable"
