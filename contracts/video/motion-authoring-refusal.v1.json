    "agent_storyboard_has_an_unexpected_key_set",
    "agent_storyboard_must_be_an_object",
    "agent_too_many_brand_assets",
    "agent_tool_surface_does_not_match_the_closed_allowlist",
    "agent_tools_require_an_authoringworkspace",
    "agent_typography_note_is_out_of_range",
    "agent_unknown_style_preset",
    "agent_unsupported_aspect_ratio",
    "agent_unsupported_language",
    "agent_video_creative_purpose_missing",
    "agent_video_model_id_missing",
    "agent_workflow_contract_is_malformed",
    "agent_workflow_contract_is_unreadable",
    "agent_workflow_reference_exceeded_its_budget",
    "agent_workflow_reference_required",
