{
  "contract": "aliyun-ims-editing-staging",
  "version": 1,
  "verified_at": "2026-07-23",
  "policy": {
    "long_lived_access_keys_only_in_rust_private_store": true,
    "secrets_never_in_react_logs_or_errors": true,
    "no_real_cloud_calls_without_user_credentials": true,
    "fail_closed": true
  },
  "sources": [
    {
      "claim": "智能媒体服务(ICE) OpenAPI 支持 6 个地域，公网接入点为 ice.{region}.aliyuncs.com",
      "url": "https://help.aliyun.com/zh/ims/developer-reference/api-ice-2020-11-09-endpoint",
      "verified_at": "2026-07-23"
    },
    {
      "claim": "SubmitMediaProducingJob 输入/输出 OSS Bucket 所在 Region 必须与使用 IMS 的 Region 一致；素材仅支持媒资库媒资或 OSS 文件，不支持外部地址或 CDN 地址",
      "url": "https://help.aliyun.com/zh/ims/developer-reference/api-ice-2020-11-09-submitmediaproducingjob",
      "verified_at": "2026-07-23"
    },
    {
      "claim": "开通 IMS 不会默认开通 OSS；不支持跨地域 OSS/VOD 素材；子账号操作需要 ICE 授权",
      "url": "https://help.aliyun.com/zh/ims/support/product-activation-faq",
      "verified_at": "2026-07-23"
    },
    {
      "claim": "RAM 支持 AliyunICEFullAccess/AliyunICEReadOnlyAccess 系统策略与 ice:{Action} 粒度自定义最小权限策略；Resource 目前仅支持全部资源(*)",
      "url": "https://help.aliyun.com/zh/ims/developer-reference/api-ice-2020-11-09-ram",
      "verified_at": "2026-07-23"
    },
    {
      "claim": "官方建议按最小权限原则为 RAM 用户授权；OSS 上传需另行授予 OSS 权限",
      "url": "https://help.aliyun.com/zh/ims/user-guide/create-and-authorize-a-ram-user-1",
      "verified_at": "2026-07-23"
    },
    {
      "claim": "RegisterMediaInfo 仅支持 OSS 文件或 VOD 媒资作为 InputURL；oss:// 形式默认与 IMS 服务同地域；注册为异步任务",
      "url": "https://help.aliyun.com/zh/ims/developer-reference/api-ice-2020-11-09-registermediainfo",
      "verified_at": "2026-07-23"
    },
    {
      "claim": "视频剪辑按成片时长与分辨率阶梯计费，不足 1 分钟按 1 分钟计，合成失败不扣费；境外地域单价为中国内地 3 倍",
      "url": "https://help.aliyun.com/zh/ims/video-clip",
      "verified_at": "2026-07-23"
    },
    {
      "claim": "OSS 生命周期规则支持按前缀匹配对象并在最后修改时间到期后删除",
      "url": "https://help.aliyun.com/zh/oss/user-guide/lifecycle-rules-based-on-the-last-modified-time",
      "verified_at": "2026-07-23"
    },
    {
      "claim": "阿里云 OpenAPI V3 签名使用 ACS3-HMAC-SHA256，需要 host、x-acs-action、x-acs-version、x-acs-date、x-acs-signature-nonce、x-acs-content-sha256 与 Authorization 头",
      "url": "https://help.aliyun.com/zh/sdk/product-overview/v3-request-structure-and-signature",
      "verified_at": "2026-07-23"
    }
  ],
  "service": {
    "provider": "aliyun_ims",
    "api_version": "2020-11-09",
    "endpoint_template": "ice.{region}.aliyuncs.com",
    "signature_algorithm": "ACS3-HMAC-SHA256",
    "connection_test_action": "ListMediaBasicInfos"
  },
  "regions": [
    {
      "region_id": "cn-beijing",
      "label": "华北2（北京）",
      "endpoint": "ice.cn-beijing.aliyuncs.com",
      "price_group": "mainland"
    },
    {
      "region_id": "cn-hangzhou",
      "label": "华东1（杭州）",
      "endpoint": "ice.cn-hangzhou.aliyuncs.com",
      "price_group": "mainland"
    },
    {
      "region_id": "cn-shanghai",
      "label": "华东2（上海）",
      "endpoint": "ice.cn-shanghai.aliyuncs.com",
      "price_group": "mainland"
    },
    {
      "region_id": "cn-shenzhen",
      "label": "华南1（深圳）",
      "endpoint": "ice.cn-shenzhen.aliyuncs.com",
      "price_group": "mainland"
    },
    {
      "region_id": "ap-southeast-1",
      "label": "新加坡",
      "endpoint": "ice.ap-southeast-1.aliyuncs.com",
      "price_group": "overseas"
    },
    {
      "region_id": "us-west-1",
      "label": "美国（硅谷）",
      "endpoint": "ice.us-west-1.aliyuncs.com",
      "price_group": "overseas"
    }
  ],
  "same_region_rule": {
    "input_output_oss_must_match_service_region": true,
    "cross_region_materials_supported": false,
    "external_or_cdn_material_urls_supported": false
  },
  "ram": {
    "system_policy_full": "AliyunICEFullAccess",
    "system_policy_readonly": "AliyunICEReadOnlyAccess",
    "ice_resource_level_authorization_supported": false,
    "minimal_policy_template": {
      "Version": "1",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "ice:GetMediaInfo",
            "ice:GetMediaProducingJob",
            "ice:ListMediaBasicInfos",
            "ice:RegisterMediaInfo",
            "ice:SubmitMediaProducingJob"
          ],
          "Resource": "*"
        },
        {
          "Effect": "Allow",
          "Action": [
            "oss:DeleteObject",
            "oss:GetObject",
            "oss:HeadObject",
            "oss:ListObjects",
            "oss:PutObject"
          ],
          "Resource": "acs:oss:*:*:{staging-bucket}/editing-staging/v1/*"
        },
        {
          "Effect": "Allow",
          "Action": ["oss:GetBucketInfo", "oss:GetBucketLocation"],
          "Resource": "acs:oss:*:*:{staging-bucket}"
        }
      ]
    }
  },
  "staging": {
    "object_key_prefix": "editing-staging/v1/",
    "object_key_template": "editing-staging/v1/{sha256}{extension}",
    "digest_algorithm": "sha256",
    "deduplication_key": "sha256",
    "retention_days": 7,
    "lifecycle_rule": {
      "match": "prefix",
      "prefix": "editing-staging/v1/",
      "action": "delete",
      "expiration_days": 7
    },
    "max_object_bytes": 2147483648,
    "max_assets_per_plan": 100,
    "allowed_extensions": [
      ".aac",
      ".jpeg",
      ".jpg",
      ".m4a",
      ".mov",
      ".mp3",
      ".mp4",
      ".png",
      ".srt",
      ".wav"
    ]
  },
  "billing": {
    "billable_item": "media_producing_output_minutes",
    "rounding": "per_started_minute",
    "failed_jobs_billed": false,
    "currency": "CNY",
    "resolution_tiers": [
      {
        "tier": "up_to_480p",
        "max_pixel_height": 480,
        "price_per_minute": { "mainland": "0.015", "overseas": "0.045" }
      },
      {
        "tier": "up_to_720p",
        "max_pixel_height": 720,
        "price_per_minute": { "mainland": "0.03", "overseas": "0.09" }
      },
      {
        "tier": "up_to_1080p",
        "max_pixel_height": 1080,
        "price_per_minute": { "mainland": "0.06", "overseas": "0.18" }
      },
      {
        "tier": "up_to_2k",
        "max_pixel_height": 1440,
        "price_per_minute": { "mainland": "0.12", "overseas": "0.36" }
      },
      {
        "tier": "up_to_4k",
        "max_pixel_height": 2160,
        "price_per_minute": { "mainland": "0.24", "overseas": "0.72" }
      }
    ],
    "excluded_items_note": "OSS 存储、请求与流量按 OSS 产品计费；本费用预估只覆盖剪辑合成计费项"
  },
  "pending_credential_verification": [
    "真实阿里云账号开通 IMS 与 OSS 的实际状态与地域可用性",
    "最小权限策略在真实 RAM 用户上的实际生效与拒绝行为",
    "真实同地域 staging bucket 的上传、生命周期删除与媒资注册",
    "真实剪辑连接测试（ListMediaBasicInfos）经 ACS3-HMAC-SHA256 签名成功",
    "真实计费单价与账单核对（官方页面价格可能调整）"
  ]
}
