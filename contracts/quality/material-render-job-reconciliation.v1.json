{
  "version": "material-render-job-reconciliation.v1",
  "authority": "tauri_app",
  "maximumActiveJobsPerStudio": 1,
  "maximumProjectedJobs": 100,
  "workerObservation": {
    "transport": "task_private_atomic_json",
    "maximumBytes": 65536,
    "pathsAllowed": false,
    "monotonicRevisionRequired": true
  },
  "statuses": ["running", "succeeded", "failed", "cancelled"],
  "cancellation": "task_private_create_once_marker",
  "artifactImport": {
    "acceptedFileName": "material-result.mp4",
    "mediaType": "video/mp4",
    "atomic": true,
    "contentAddressed": true
  },
  "workerDeletionAllowed": false,
  "appOwnsRetentionAndDeletion": true
}
