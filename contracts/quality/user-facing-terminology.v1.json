      ".json",
      ".md",
      ".scss",
      ".ts",
      ".tsx"
    ],
    "maximumFileBytes": 1048576
  },
  "embeddedWebUiScan": {
    "roots": [
      "vendor/moneyprinterturbo/webui"
    ],
    "excludedGlobs": [],
    "textExtensions": [
      ".css",
      ".json",
      ".py"
    ],
    "maximumFileBytes": 1048576,
    "exposureCount": 10,
    "exposureSha256": "bb4168583c4ec780306888ec7102a9d108ff67162947b369bcae7dfaa15eed94",
    "reason": "The material-video WebUI a user opens is upstream code, so it names the upstream project in its own sources on purpose and cannot be scanned like ours. The product neutralises every occurrence in frontend/src-tauri/src/material_video_studio_init.js, which forces the document title, rewrites text nodes and accessibility attributes, strips external links and fails closed when any survives; frontend/e2e-tauri/material-video-webui.spec.ts proves the rendered result through the normal product entry, but only with a full desktop build. Pinning the exposure surface here turns an upstream upgrade that adds, moves or rewords an occurrence red at normal gate speed, so the guard is re-checked before the change can reach a customer.",
    "surfaces": [
      "page_title in st.set_page_config",
      "menu_items 'Report a bug' and 'About', reachable only through the header upstream styles.css already hides",
      "the brand span inside the .mpt-brand heading",
      "the GitHub href and its aria-label on the version link",
      "an aff= tracking parameter inside the Kimi model-list link in webui/i18n/en.json and webui/i18n/zh.json",
      "one Python comment that never reaches the page"
    ]
  },
  "nativeScan": {
    "roots": [
      "frontend/src-tauri/src",
      "backend/src"
    ],
    "excludedGlobs": [
      "**/__pycache__/**",
      "backend/src/automation_tool/executor/motion_authoring/agent.py"
    ],
    "excludedGlobsReason": "motion_authoring/agent.py 里的中文全部是发给视频创作模型的提示词，不是给用户看的文案：它必须逐字写出 window.__timelines、GSAP 时间轴、autoAlpha 这些代码标识，模型照着它写合成代码，改成通俗说法会直接把生成链路写坏。该模块不向用户输出任何文案——它的异常是英文内部串，执行器入口有意不转发原因，用户看到的文案由 Rust 侧映射产生。",
    "excludedGlobsCostAndTrigger": "这条排除是按位置表达一个按种类的例外，代价是整个文件对门禁全盲：以后谁往这里加一句会被转发给用户的中文消息，门禁会静默放行。上面那句「该模块不向用户输出任何文案」目前只是人工核实过的结论，不是被检查的事实。触发条件：再出现第二个提示词模块时，不要追加第二行 glob。改成按种类声明——promptText 记录「模块 + 提示词符号名」，扫描器只跳过这些符号里的字面量，文件其余部分继续扫，那条不变量也就随之变成被检查的。更彻底的做法是把提示词从 backend/src 挪进数据文件：它本来就不是源码文案而是喂给模型的输入，挪出去还能独立 review 和 diff；但那是 1518 行模块的真实重构且会动生成链路，放到 AI 员工与工作流阶段一起做，不要在演示前碰。",
    "textExtensions": [
      ".py",
      ".rs"
    ],
    "artifactFileExtensions": [
      ".csv",
      ".mov",
      ".mp3",
      ".mp4",
      ".srt",
      ".vtt",
      ".wav",
      ".zip"
    ],
    "maximumFileBytes": 1048576
  },
  "rules": [
    "internal_provider_ids_never_become_display_names",
    "raw_worker_submodule_or_provider_errors_never_reach_users",
    "technical_terms_use_plain_language_mapping_or_immediate_explanation",
    "upstream_names_only_appear_on_separate_required_legal_page",
    "safe_task_export_and_artifact_names_use_product_terms_only"
  ],
