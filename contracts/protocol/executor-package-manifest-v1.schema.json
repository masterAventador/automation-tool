{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation-tool.local/contracts/executor-package-manifest-v1.schema.json",
  "title": "Executor package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "executor_version",
    "build_id",
    "platform",
    "architecture",
    "entrypoint",
    "package_size",
    "package_sha256",
    "files"
  ],
  "properties": {
    "manifest_version": {
      "const": "1"
    },
    "executor_version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "build_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "platform": {
      "enum": ["macos", "windows"]
    },
    "architecture": {
      "enum": ["aarch64", "x86_64"]
    },
    "entrypoint": {
      "enum": ["automation-tool-executor", "automation-tool-executor.exe"]
    },
    "package_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8589934592
    },
    "package_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "platform": {
            "const": "windows"
          }
        },
        "required": ["platform"]
      },
      "then": {
        "properties": {
          "entrypoint": {
            "const": "automation-tool-executor.exe"
          }
        }
      },
      "else": {
        "properties": {
          "entrypoint": {
            "const": "automation-tool-executor"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[ -~]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934592
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
