    "TaskCommandEnvelope": {
      "additionalProperties": false,
      "description": "Control Plane commands that target one execution attempt.",
      "properties": {
        "correlation_id": {
          "maxLength": 36,
          "minLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Correlation Id",
